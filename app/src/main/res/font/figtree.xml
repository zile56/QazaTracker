<?xml version="1.0" encoding="utf-8"?>
<!--
  Figtree ships from Google Fonts only as a variable font (no static Regular/Bold
  files). This font-family resource pulls the 400 and 700 weights out of the single
  variable TTF — the standard Android pattern for consuming a variable font.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/figtree_variable"
        android:fontStyle="normal"
        android:fontWeight="400" />
    <font
        android:font="@font/figtree_variable"
        android:fontStyle="normal"
        android:fontWeight="700" />
</font-family>
